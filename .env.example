# Azure AI Foundry model connection
NFL_COACH_MODEL_PROVIDER=azure_foundry
FOUNDRY_MODEL=replace-with-foundry-deployment-name
FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
FOUNDRY_UPSTREAM_URL=https://example.org/upstream-open-model-project
FOUNDRY_MODEL_LICENSE=Apache-2.0
# Optional when DefaultAzureCredential is unavailable:
AZURE_FOUNDRY_API_KEY=

# Optional Responses API reasoning effort for reasoning-capable Foundry models.
# Supported values vary by deployment: none, minimal, low, medium, high, xhigh, max.
# Leave unset to use the deployment's default behavior.
AZURE_FOUNDRY_REASONING_EFFORT=

# Console diagnostics: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
NFL_COACH_LOG_LEVEL=INFO
